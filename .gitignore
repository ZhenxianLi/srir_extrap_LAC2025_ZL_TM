# macOS/Windows housekeeping / 系统垃圾文件
.DS_Store
Thumbs.db
desktop.ini

# Claude Code working files / Claude 工作目录（不要 commit）
.claude/

# MATLAB scratch / MATLAB 临时文件
*.asv
*.autosave
*.mex*
slprj/

# Local figures and audio output (generated by run_* scripts)
# 由 run_paper_figures.m / run_beamforming.m 生成的图片和音频
figures/
audio_out/

# Large SOFA datasets (downloaded on first run, ~565 MB)
# 第一次运行会下载，体积太大不入库
6dof_SRIRs_eigenmike_SH/*.sofa

# AMT toolbox (optional, ~1-2 GB after auxdata)
# AMT 工具箱（可选；installDependencies('InstallAMT', true) 安装到这里）
external/amtoolbox/

# Editor / IDE
.vscode/
.idea/
